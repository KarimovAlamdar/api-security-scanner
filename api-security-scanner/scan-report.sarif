{
  "$schema" : "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version" : "2.1.0",
  "runs" : [ {
    "tool" : {
      "driver" : {
        "name" : "api-security-scanner",
        "semanticVersion" : "1.2.0",
        "informationUri" : "https://github.com/scanner/api-security-scanner",
        "rules" : [ {
          "id" : "BOLA_IDOR_VULNERABILITY",
          "name" : "BrokenObjectLevelAuthorization",
          "shortDescription" : {
            "text" : "Broken Object Level Authorization (BOLA / IDOR)"
          },
          "fullDescription" : {
            "text" : "Cross-tenant or secondary user accessed or modified another user's private object without authorization check."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Cross-tenant or secondary user accessed or modified another user's private object without authorization check.",
            "markdown" : "**Broken Object Level Authorization (BOLA / IDOR)**\n\nCross-tenant or secondary user accessed or modified another user's private object without authorization check."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "9.5",
            "tags" : [ "security", "owasp-api1", "CWE-639", "CWE-285" ]
          }
        }, {
          "id" : "SQLI_INDICATOR",
          "name" : "SqlInjectionIndicator",
          "shortDescription" : {
            "text" : "Database syntax error suggests potential SQL Injection"
          },
          "fullDescription" : {
            "text" : "Fuzzing payload triggered database syntax error or SQL exception in server response."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Fuzzing payload triggered database syntax error or SQL exception in server response.",
            "markdown" : "**Database syntax error suggests potential SQL Injection**\n\nFuzzing payload triggered database syntax error or SQL exception in server response."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "9.0",
            "tags" : [ "security", "owasp-api8", "CWE-89" ]
          }
        }, {
          "id" : "AUTH_BYPASS",
          "name" : "AuthenticationBypass",
          "shortDescription" : {
            "text" : "Endpoint missing authentication requirement"
          },
          "fullDescription" : {
            "text" : "Secured or state-changing endpoint accepted a request without valid authentication credentials."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Secured or state-changing endpoint accepted a request without valid authentication credentials.",
            "markdown" : "**Endpoint missing authentication requirement**\n\nSecured or state-changing endpoint accepted a request without valid authentication credentials."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "8.5",
            "tags" : [ "security", "owasp-api2", "CWE-306" ]
          }
        }, {
          "id" : "XSS_REFLECTED",
          "name" : "ReflectedCrossSiteScripting",
          "shortDescription" : {
            "text" : "Reflected Cross-Site Scripting (XSS)"
          },
          "fullDescription" : {
            "text" : "Input payload was echoed unencoded in the response body, enabling script injection in user browsers."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Input payload was echoed unencoded in the response body, enabling script injection in user browsers.",
            "markdown" : "**Reflected Cross-Site Scripting (XSS)**\n\nInput payload was echoed unencoded in the response body, enabling script injection in user browsers."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "8.5",
            "tags" : [ "security", "owasp-api8", "CWE-79" ]
          }
        }, {
          "id" : "CORS_REFLECTED_ORIGIN",
          "name" : "CorsReflectedOrigin",
          "shortDescription" : {
            "text" : "CORS reflects arbitrary origin with credentials"
          },
          "fullDescription" : {
            "text" : "Endpoint reflects arbitrary Origin header while setting Access-Control-Allow-Credentials: true."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Endpoint reflects arbitrary Origin header while setting Access-Control-Allow-Credentials: true.",
            "markdown" : "**CORS reflects arbitrary origin with credentials**\n\nEndpoint reflects arbitrary Origin header while setting Access-Control-Allow-Credentials: true."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "8.0",
            "tags" : [ "security", "owasp-api7", "CWE-942" ]
          }
        }, {
          "id" : "CORS_WILDCARD",
          "name" : "CorsWildcardOrigin",
          "shortDescription" : {
            "text" : "CORS wildcard origin allows cross-origin reading"
          },
          "fullDescription" : {
            "text" : "Endpoint returns Access-Control-Allow-Origin: * allowing untrusted third-party origins to access API."
          },
          "defaultConfiguration" : {
            "level" : "warning"
          },
          "help" : {
            "text" : "Endpoint returns Access-Control-Allow-Origin: * allowing untrusted third-party origins to access API.",
            "markdown" : "**CORS wildcard origin allows cross-origin reading**\n\nEndpoint returns Access-Control-Allow-Origin: * allowing untrusted third-party origins to access API."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "6.0",
            "tags" : [ "security", "owasp-api7", "CWE-942" ]
          }
        }, {
          "id" : "MISSING_HSTS",
          "name" : "MissingStrictTransportSecurity",
          "shortDescription" : {
            "text" : "Missing or weak Strict-Transport-Security (HSTS) header"
          },
          "fullDescription" : {
            "text" : "Response does not include HSTS or max-age is below recommended 6-month minimum, allowing protocol downgrade attacks."
          },
          "defaultConfiguration" : {
            "level" : "warning"
          },
          "help" : {
            "text" : "Response does not include HSTS or max-age is below recommended 6-month minimum, allowing protocol downgrade attacks.",
            "markdown" : "**Missing or weak Strict-Transport-Security (HSTS) header**\n\nResponse does not include HSTS or max-age is below recommended 6-month minimum, allowing protocol downgrade attacks."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "5.5",
            "tags" : [ "security", "owasp-api7", "CWE-319" ]
          }
        }, {
          "id" : "COOKIE_NO_HTTPONLY",
          "name" : "CookieMissingHttpOnly",
          "shortDescription" : {
            "text" : "Cookie missing HttpOnly flag"
          },
          "fullDescription" : {
            "text" : "Set-Cookie header does not include HttpOnly attribute, making cookie accessible to JavaScript and vulnerable to XSS theft."
          },
          "defaultConfiguration" : {
            "level" : "warning"
          },
          "help" : {
            "text" : "Set-Cookie header does not include HttpOnly attribute, making cookie accessible to JavaScript and vulnerable to XSS theft.",
            "markdown" : "**Cookie missing HttpOnly flag**\n\nSet-Cookie header does not include HttpOnly attribute, making cookie accessible to JavaScript and vulnerable to XSS theft."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "5.5",
            "tags" : [ "security", "owasp-api8", "CWE-1004" ]
          }
        }, {
          "id" : "COOKIE_NO_SECURE",
          "name" : "CookieMissingSecure",
          "shortDescription" : {
            "text" : "Cookie missing Secure flag on HTTPS endpoint"
          },
          "fullDescription" : {
            "text" : "Set-Cookie header on an HTTPS endpoint does not include Secure attribute, allowing cookie transmission over plaintext HTTP."
          },
          "defaultConfiguration" : {
            "level" : "warning"
          },
          "help" : {
            "text" : "Set-Cookie header on an HTTPS endpoint does not include Secure attribute, allowing cookie transmission over plaintext HTTP.",
            "markdown" : "**Cookie missing Secure flag on HTTPS endpoint**\n\nSet-Cookie header on an HTTPS endpoint does not include Secure attribute, allowing cookie transmission over plaintext HTTP."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "5.0",
            "tags" : [ "security", "owasp-api8", "CWE-614" ]
          }
        }, {
          "id" : "ERROR_LEAK",
          "name" : "InternalErrorLeak",
          "shortDescription" : {
            "text" : "Endpoint leaks internal stack trace or framework error details"
          },
          "fullDescription" : {
            "text" : "Server returned stack trace or internal error messages containing implementation details."
          },
          "defaultConfiguration" : {
            "level" : "warning"
          },
          "help" : {
            "text" : "Server returned stack trace or internal error messages containing implementation details.",
            "markdown" : "**Endpoint leaks internal stack trace or framework error details**\n\nServer returned stack trace or internal error messages containing implementation details."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "5.0",
            "tags" : [ "security", "CWE-209" ]
          }
        }, {
          "id" : "MISSING_CSP",
          "name" : "MissingContentSecurityPolicy",
          "shortDescription" : {
            "text" : "Missing Content-Security-Policy header"
          },
          "fullDescription" : {
            "text" : "Response does not include Content-Security-Policy header, leaving clients vulnerable to content injection attacks."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "Response does not include Content-Security-Policy header, leaving clients vulnerable to content injection attacks.",
            "markdown" : "**Missing Content-Security-Policy header**\n\nResponse does not include Content-Security-Policy header, leaving clients vulnerable to content injection attacks."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "4.0",
            "tags" : [ "security", "owasp-api7", "CWE-693" ]
          }
        }, {
          "id" : "MISSING_XCTO",
          "name" : "MissingXContentTypeOptions",
          "shortDescription" : {
            "text" : "Missing or incorrect X-Content-Type-Options header"
          },
          "fullDescription" : {
            "text" : "Response does not include X-Content-Type-Options: nosniff, allowing MIME-type sniffing attacks."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "Response does not include X-Content-Type-Options: nosniff, allowing MIME-type sniffing attacks.",
            "markdown" : "**Missing or incorrect X-Content-Type-Options header**\n\nResponse does not include X-Content-Type-Options: nosniff, allowing MIME-type sniffing attacks."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "3.5",
            "tags" : [ "security", "owasp-api7", "CWE-693" ]
          }
        }, {
          "id" : "MISSING_XFO",
          "name" : "MissingXFrameOptions",
          "shortDescription" : {
            "text" : "Missing X-Frame-Options / CSP frame-ancestors"
          },
          "fullDescription" : {
            "text" : "Response lacks both X-Frame-Options header and CSP frame-ancestors directive, enabling clickjacking attacks."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "Response lacks both X-Frame-Options header and CSP frame-ancestors directive, enabling clickjacking attacks.",
            "markdown" : "**Missing X-Frame-Options / CSP frame-ancestors**\n\nResponse lacks both X-Frame-Options header and CSP frame-ancestors directive, enabling clickjacking attacks."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "3.5",
            "tags" : [ "security", "owasp-api7", "CWE-1021" ]
          }
        }, {
          "id" : "COOKIE_NO_SAMESITE",
          "name" : "CookieMissingSameSite",
          "shortDescription" : {
            "text" : "Cookie missing SameSite attribute"
          },
          "fullDescription" : {
            "text" : "Set-Cookie header does not include SameSite attribute (or uses SameSite=None without Secure), enabling CSRF attacks."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "Set-Cookie header does not include SameSite attribute (or uses SameSite=None without Secure), enabling CSRF attacks.",
            "markdown" : "**Cookie missing SameSite attribute**\n\nSet-Cookie header does not include SameSite attribute (or uses SameSite=None without Secure), enabling CSRF attacks."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "3.5",
            "tags" : [ "security", "owasp-api8", "CWE-1275" ]
          }
        }, {
          "id" : "SERVER_VERSION_LEAK",
          "name" : "ServerVersionDisclosure",
          "shortDescription" : {
            "text" : "Server header discloses version information"
          },
          "fullDescription" : {
            "text" : "The Server response header reveals software name and version, aiding attackers in identifying known vulnerabilities."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "The Server response header reveals software name and version, aiding attackers in identifying known vulnerabilities.",
            "markdown" : "**Server header discloses version information**\n\nThe Server response header reveals software name and version, aiding attackers in identifying known vulnerabilities."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "3.0",
            "tags" : [ "security", "CWE-200" ]
          }
        }, {
          "id" : "TECH_STACK_LEAK",
          "name" : "TechnologyStackDisclosure",
          "shortDescription" : {
            "text" : "X-Powered-By header leaks technology stack"
          },
          "fullDescription" : {
            "text" : "The X-Powered-By header reveals framework or runtime details, aiding targeted exploitation."
          },
          "defaultConfiguration" : {
            "level" : "note"
          },
          "help" : {
            "text" : "The X-Powered-By header reveals framework or runtime details, aiding targeted exploitation.",
            "markdown" : "**X-Powered-By header leaks technology stack**\n\nThe X-Powered-By header reveals framework or runtime details, aiding targeted exploitation."
          },
          "properties" : {
            "precision" : "high",
            "security-severity" : "3.0",
            "tags" : [ "security", "CWE-200" ]
          }
        }, {
          "id" : "SSRF_DETECTED",
          "name" : "ServerSideRequestForgery",
          "shortDescription" : {
            "text" : "Server-Side Request Forgery (SSRF) to cloud metadata or internal host"
          },
          "fullDescription" : {
            "text" : "Endpoint forwarded request to internal cloud metadata service (169.254.169.254) or localhost and returned internal metadata or service banners."
          },
          "defaultConfiguration" : {
            "level" : "error"
          },
          "help" : {
            "text" : "Endpoint forwarded request to internal cloud metadata service (169.254.169.254) or localhost and returned internal metadata or service banners.",
            "markdown" : "**Server-Side Request Forgery (SSRF) to cloud metadata or internal host**\n\nEndpoint forwarded request to internal cloud metadata service (169.254.169.254) or localhost and returned internal metadata or service banners."
